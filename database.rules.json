{
  "rules": {
    ".read": false,
    ".write": false,
    "teachers": {
      "$teacherId": {
        "classes": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $teacherId"
        },
        "groups": {
          ".read": "auth != null && (auth.uid === $teacherId || auth.token.firebase.sign_in_provider === 'anonymous')",
          ".write": "auth != null && auth.uid === $teacherId"
        },
        "submissions": {
          "$submissionId": {
            ".read": "auth != null && auth.uid === $teacherId",
            ".write": "auth != null && (auth.uid === $teacherId || (!data.exists() && auth.token.firebase.sign_in_provider === 'anonymous' && newData.child('teacherId').val() === $teacherId && root.child('teachers').child($teacherId).child('classes').child(newData.child('classId').val()).exists()))",
            ".validate": "newData.hasChildren(['teacherId', 'classId', 'className', 'groupName', 'members', 'submittedAt'])"
          }
        }
      }
    }
  }
}
